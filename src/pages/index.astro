---
import Layout from '../layouts/Layout.astro';
import { LandingPage } from '../react-pages/public/LandingPage';
import { Navbar } from '../components/Navbar';
import { Footer } from '../components/Footer';
import { SupabaseService } from '../lib/supabase';
import { INITIAL_SETTINGS, INITIAL_NAV_ITEMS } from '../lib/initialData';

// Server-side/Build-side fetch
let settings = INITIAL_SETTINGS;
let navItems = INITIAL_NAV_ITEMS;
let pengurusList = [];

try {
  const [sData, nData, pData] = await Promise.all([
    SupabaseService.fetchSettings(),
    SupabaseService.fetchNavItems(),
    SupabaseService.fetchPengurus()
  ]);
  if (sData) settings = sData;
  if (nData) navItems = nData;
  if (pData) pengurusList = pData;
} catch (err) {
  console.warn("Server fetch failed:", err);
}
---

<Layout>
  <Navbar 
    currentRole="public" 
    userProfile={null} 
    onOpenAuth={() => { window.location.href = '/login'; }}
    onOpenDashboard={() => { window.location.href = '/admin/dashboard'; }}
    onLogout={() => {}} 
    activeSection="beranda" 
    navItems={navItems}
    client:load
  />
  <main class="flex-grow">
    <LandingPage 
      currentRole="public" 
      navigateTo={(path) => { window.location.href = path; }}
      settings={settings}
      navItems={navItems}
      pengurusList={pengurusList}
      client:load
    />
  </main>
  <Footer settings={settings} />
</Layout>
