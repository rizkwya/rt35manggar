---
import Layout from '../../layouts/Layout.astro';
import { App } from '../../App';

export function getStaticPaths() {
  return [
    { params: { slug: undefined } },
    { params: { slug: 'dashboard' } },
    { params: { slug: 'developer' } },
    { params: { slug: 'demografis' } },
    { params: { slug: 'pengumuman' } },
    { params: { slug: 'pengurus' } },
    { params: { slug: 'kegiatan-warga' } },
    { params: { slug: 'kkn-team' } },
    { params: { slug: 'kkn-proker' } },
    { params: { slug: 'settings' } },
    { params: { slug: 'menu-halaman' } },
    { params: { slug: 'fasilitas' } },
    { params: { slug: 'berita' } },
    { params: { slug: 'aspirasi' } }
  ];
}
---

<Layout title="Dashboard Pelayanan Digital RT 35 Manggar">
  <App client:only="react">
    <!-- Static Skeleton Loader for Dashboard -->
    <div class="flex flex-col items-center justify-center min-h-screen bg-slate-50 space-y-4">
      <div class="animate-spin rounded-full h-10 w-10 border-b-2 border-[#0b5665]"></div>
      <p class="text-xs font-bold text-slate-400 animate-pulse">Menghubungkan ke sistem pelayanan RT 35...</p>
    </div>
  </App>
</Layout>
