---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar';
import Footer from '../../components/Footer';
import { CustomPageDetail } from '../../react-pages/CustomPageDetail';
import { SupabaseService } from '../../lib/supabase';
import { INITIAL_NAV_ITEMS, INITIAL_SETTINGS } from '../../lib/initialData';

export async function getStaticPaths() {
  let navItems = INITIAL_NAV_ITEMS;
  try {
    const data = await SupabaseService.fetchNavItems();
    if (data) navItems = data;
  } catch (e) {
    console.warn("Failed fetching nav items for static paths:", e);
  }

  const customPages = navItems.filter(item => item.type === 'custom_page');
  return customPages.map(page => ({
    params: { slug: page.target_id }
  }));
}

const { slug } = Astro.params;

let navItems = INITIAL_NAV_ITEMS;
let settings = INITIAL_SETTINGS;
let pageItem = null;

try {
  const [nvData, sData] = await Promise.all([
    SupabaseService.fetchNavItems(),
    SupabaseService.fetchSettings()
  ]);
  if (nvData) navItems = nvData;
  if (sData) settings = sData;
  pageItem = navItems.find(item => item.target_id === slug && item.type === 'custom_page');
} catch (e) {
  console.warn("Custom page fetch failed:", e);
}

if (!pageItem) {
  return Astro.redirect('/');
}
---

<Layout title={`${pageItem.label} – Portal RT 35 Kelurahan Manggar`}>
  <Navbar 
    currentRole="public" 
    userProfile={null} 
    onOpenAuth={() => { window.location.href = '/login'; }}
    onOpenDashboard={() => { window.location.href = '/admin/dashboard'; }}
    onLogout={() => {}} 
    activeSection="" 
    navItems={navItems}
    client:load
  />
  <main class="flex-grow pt-24 md:pt-28 min-h-screen bg-slate-50">
    <CustomPageDetail pageItem={pageItem} slug={slug} client:load />
  </main>
  <Footer settings={settings} />
</Layout>
